# BioNest Environment Configuration

# 1. Supabase Project Credentials
# Obtain these from your Supabase Dashboard: Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Application Base URL
# Local development:
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production:
# NEXT_PUBLIC_APP_URL=https://bionest.link

# 3. Analytics Anonymization Salt (random string used for daily visitor hashing)
VISITOR_SALT=bionest-production-visitor-salt-change-in-prod-xyz
